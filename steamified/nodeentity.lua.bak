local oldnew = vector.new
vector.new = function(x, y, z, r)
	local newvec = oldnew(x, y, z)
	newvec.relative = r
	return newvec
end

local oldadd = vector.add
vector.add = function(a, b)
	local newvec = oldadd(a, b)
	newvec.relative = a.relative or ((type(b) == "table") and b.relative)
	return newvec
end

relativize_func(vector, "subtract")

local vecmetatable = vector.metatable

oldmetaadd = vecmetatable.__add
vecmetatable.__add = function(a, b)
	local newvec = oldmetaadd(a, b)
	newvec.relative = a.relative or b.relative
	return newvec
end

relativize_func(vecmetatable, "__sub")
relativize_func(vecmetatable, "__unm")

local oldshowformspec = core.show_formspec
local newshowformspec = function(entity)
	local invname = "detached:"..entity._invname
	local meta = entity._metadata
	return function(playername, formname, formspec)
		while true do
			local i, j = formspec:find("%$%{.-%}")
			if not i then break end
			local key = formspec:sub(i + 2, j - 1)
			formspec = formspec:gsub("%$%{"..key.."%}", meta:get_string(key))
		end
		-- Generic replacement handling brackets, semicolons, and spaces safely
		formspec = formspec:gsub("nodemeta:[%-%d,]+", invname):gsub("context", invname)
		fs_context[formname] = fs_context[formname] or {}
		fs_context[formname][playername] = {formspec, entity}
		entity._prevfs = formspec
		oldshowformspec(playername, formname, formspec)
	end
end

local parseformspec = function(formspec, entity)
	local invname = "detached:"..entity._invname
	local meta = entity._metadata
	while true do
		local i, j = formspec:find("%$%{.-%}")
		if not i then break end
		local key = formspec:sub(i + 2, j - 1)
		formspec = formspec:gsub("%$%{"..key.."%}", meta:get_string(key))
	end
	-- Generic replacement handling brackets, semicolons, and spaces safely
	return formspec:gsub("nodemeta:[%-%d,]+", invname):gsub("context", invname)
end

local init_context = function(entity)
	core.show_formspec = newshowformspec(entity)
end
local fin_context = function()
	core.show_formspec = oldshowformspec
end

local t = core.registered_on_player_receive_fields
core.register_last_on_player_receive_fields = function(func)
	t[#t + 1] = func
	core.callback_origins[func] = {
		-- may be nil or return nil
		mod = core.get_current_modname and core.get_current_modname() or "??",
		name = debug.getinfo(1, "n").name or "??"
	}
end

core.register_last_on_player_receive_fields(function(player, formname, fields) -- ANTIPRIORITY
	local pname = player:get_player_name()
	if fs_context[formname] and fs_context[formname][pname] then
		fin_context()
		if fields.quit then fs_context[formname][pname] = nil end
	end
end)

core.register_on_player_receive_fields(function(player, formname, fields)
	if formname:sub(0, 11) == "steamified:" then
		local data = formname:split(";", true, 1)
		local nodename = (data[1]):gsub("steamified:",""):gsub("__",":")
		local def = core.registered_nodes[nodename]
		local entity = nodeentities[data[2]]
		
		-- Check if both the node definition and the formspec callback exist
		if def and def.on_receive_fields then
			init_context(entity)
			def.on_receive_fields(construct_relpos(entity), formname, fields, player, entity)
			fin_context()
		end
	end
end)

local abm_neighbors = {
	vector.new(-1,-1,-1),
	vector.new( 0,-1,-1),
	vector.new( 1,-1,-1),
	vector.new(-1, 0,-1),
	vector.new( 0, 0,-1),
	vector.new( 1, 0,-1),
	vector.new(-1, 1,-1),
	vector.new( 0, 1,-1),
	vector.new( 1, 1,-1),
	vector.new(-1,-1, 0),
	vector.new( 0,-1, 0),
	vector.new( 1,-1, 0),
	vector.new(-1, 0, 0),
	vector.new( 1, 0, 0),
	vector.new(-1, 1, 0),
	vector.new( 0, 1, 0),
	vector.new( 1, 1, 0),
	vector.new(-1,-1, 1),
	vector.new( 0,-1, 1),
	vector.new( 1,-1, 1),
	vector.new(-1, 0, 1),
	vector.new( 0, 0, 1),
	vector.new( 1, 0, 1),
	vector.new(-1, 1, 1),
	vector.new( 0, 1, 1),
	vector.new( 1, 1, 1),
}

local function check_neighbors(pos, include, exclude)
	local function normalize_list(x)
		if not x then return nil end
		if type(x) == "string" then return {x} end
		if type(x) == "table" then return x end
		return nil
	end

	include = normalize_list(include)
	exclude = normalize_list(exclude)

	local includeset = {}
	local excludeset = {}
	local igroups    = {}
	local egroups    = {}
	local icheck
	if include then
		for _, n in ipairs(include) do
			local s = tostring(n)
			if s:sub(1,6) == "group:" then
				table.insert(igroups, s:sub(7))
			else
				includeset[s] = true
			end
		end
	else
		icheck = true
	end
	if exclude then
		for _, n in ipairs(exclude) do
			local s = tostring(n)
			if s:sub(1,6) == "group:" then
				table.insert(egroups, s:sub(7))
			else
				excludeset[s] = true
			end
		end
	end
	for _, neighbor in ipairs(abm_neighbors) do
		local name = core.get_node(pos + neighbor).name
		if excludeset[name] then return false end
		if not icheck then
			if includeset[name] then icheck = true end
			for _, group in ipairs(igroups) do
				if core.get_item_group(name, group) then icheck = true end
			end
		end
		for _, group in ipairs(egroups) do
			if core.get_item_group(name, group) then return false end
		end
	end
	return icheck
end

local invcallbacks = function(entity)
	local relpos = construct_relpos(entity)
	local node = entity:get_node()
	local def = node and core.registered_nodes[node.name]
	if not def then
		return {}
	end
	return {
	allow_move = def.allow_metadata_inventory_move and function(inv, from_list, from_index, to_list, to_index, count, player)
		init_context(entity)
		local r = def.allow_metadata_inventory_move(relpos, from_list, from_index, to_list, to_index, count, player, entity)
		fin_context()
		return r
	end,

	allow_put = def.allow_metadata_inventory_put and function(inv, listname, index, stack, player)
		init_context(entity)
		local r = def.allow_metadata_inventory_put(relpos, listname, index, stack, player, entity)
		fin_context()
		return r
	end,

	allow_take = def.allow_metadata_inventory_take and function(inv, listname, index, stack, player)
		init_context(entity)
		local r = def.allow_metadata_inventory_take(relpos, listname, index, stack, player, entity)
		fin_context()
		return r
	end,
		
	on_move = def.on_metadata_inventory_move and function(inv, from_list, from_index, to_list, to_index, count, player)
		init_context(entity)
		def.on_metadata_inventory_move(relpos, from_list, from_index, to_list, to_index, count, player, entity)
		fin_context()
	end,

	on_put = def.on_metadata_inventory_put and function(inv, listname, index, stack, player)
		init_context(entity)
		def.on_metadata_inventory_put(relpos, listname, index, stack, player, entity)
		fin_context()
	end,

	on_take = def.on_metadata_inventory_take and function(inv, listname, index, stack, player)
		init_context(entity)
		def.on_metadata_inventory_take(relpos, listname, index, stack, player, entity)
		fin_context()
	end,
} end

local rclick = function(self, clicker)
	local node = self:get_node()
	local def = node and core.registered_nodes[node.name]
	
	if def and def.on_rightclick then
		init_context(self)
		local retval = def.on_rightclick(construct_relpos(self), node, clicker, clicker:get_wielded_item(), {
			type = "node",
			under = self.object:get_pos(),
			above = nil
		}, self)
		fin_context()
		if retval then clicker:set_wielded_item(retval) end
		return
	end

	local stack = clicker:get_wielded_item()
	local itemname = stack:get_name()
	local itemdef = core.registered_nodes[itemname]

	if itemdef then
		local reach = core.is_creative_enabled(clicker:get_player_name()) and 10 or (itemdef.range or 4)
		
		local eye = clicker:get_pos()
		eye.y = eye.y + clicker:get_properties().eye_height
		eye = vector.add(eye, clicker:get_eye_offset())
		local look_dir = clicker:get_look_dir()

		-- Fetch the structural parent holding the rotated grid
		local parent_obj, _, _ = self.object:get_attach()
		if parent_obj and parent_obj:get_pos() then
			local parent_pos = parent_obj:get_pos()
			local parent_ent = parent_obj:get_luaentity()
			
			-- Retrieve rotation state (fallback to standard zero vector if unassigned)
			local rot_deg = (parent_ent and parent_ent._rotation) or parent_obj:get_rotation() or {x = 0, y = 0, z = 0}
			-- Standard engine get_rotation() returns radians, custom fields usually use degrees.
			-- Ensure we are working with Radians:
			local rot_rad = parent_ent and parent_ent._rotation and vector.multiply(rot_deg, math.pi / 180) or rot_deg

			-- 1. Transform eye origin to local space relative to the parent position
			local local_eye = vector.subtract(eye, parent_pos)
			
			-- Apply inverse rotation order: Z (Roll) -> Y (Yaw) -> X (Pitch)
			local_eye = vector.rotate_around_axis(local_eye, {x = 0, y = 0, z = 1}, -rot_rad.z)
			local_eye = vector.rotate_around_axis(local_eye, {x = 0, y = 1, z = 0}, -rot_rad.y)
			local_eye = vector.rotate_around_axis(local_eye, {x = 1, y = 0, z = 0}, -rot_rad.x)

			-- 2. Transform the look direction vector into local space
			local local_dir = look_dir
			local_dir = vector.rotate_around_axis(local_dir, {x = 0, y = 0, z = 1}, -rot_rad.z)
			local_dir = vector.rotate_around_axis(local_dir, {x = 0, y = 1, z = 0}, -rot_rad.y)
			local_dir = vector.rotate_around_axis(local_dir, {x = 1, y = 0, z = 0}, -rot_rad.x)

			-- 3. Run raycast against the clicked node's local position inside the group
			local local_pos = construct_relpos(self)
			local min_pos = vector.subtract(local_pos, 0.5)
			local max_pos = vector.add(local_pos, 0.5)

			local local_normal, dist = ray_intersect_aabb(local_eye, local_dir, min_pos, max_pos)

			-- 4. Calculate neighbor position relative to rotation matrix if verified
			if local_normal and dist <= reach then
				local target_pos = vector.add(local_pos, local_normal)
				
				-- Maintain the virtual coordinates integrity
				local existing_node = core.get_node(target_pos)
				if existing_node.name == "air" or existing_node.name == "ignore" or 
				   (core.registered_nodes[existing_node.name] and core.registered_nodes[existing_node.name].buildable_to) then
					
					core.set_node(target_pos, {name = itemname})
					
					if not core.is_creative_enabled(clicker:get_player_name()) then
						stack:take_item()
						clicker:set_wielded_item(stack)
					end
					return
				end
			end
		end
	end

	-- Fallback UI configuration
	local fs = self._metadata:get_string("formspec")
	if fs and fs ~= "" then
		-- Clean the node name using the exact entity ID instead of recalculating relative vectors
		local fname = "steamified:" .. node.name:gsub(":", "__") .. ";" .. self._eID
		self._showfs(clicker:get_player_name(), fname, fs)
	end-- Fallback UI configuration
	local fs = self._metadata:get_string("formspec")
	local fname = "steamified:" .. node.name:gsub(":", "__") .. ";" .. self._eID
	self._showfs(clicker:get_player_name(), fname, fs)
end

local deactivate = function(self, removal)
	if self._NOELIM then return end
	init_context(self)
	local node = self:get_node()
	local def = node and core.registered_nodes[node.name]
	local relpos = construct_relpos(self)
	if removal then
		if def and def.on_destruct then
			def.on_destruct(relpos, self)
		end
		nodeentities[self._eID] = nil
		usednames:set_string(self._eID, "")
		if def and def.after_destruct then
			local node = self:get_node()
			if node then
				def.after_destruct(self.object:get_pos(), node, self)
			end
		end
	else
		self._NOREMOVE = true
	end
	fin_context()
end

local death = function(self, killer)
	local node = self:get_node()
	local def = node and core.registered_nodes[node.name]
	if def and def.after_dig_node then
		init_context(self)
		def.after_dig_node(convert_pos(construct_relpos(self)), node, self._metadata, killer, self)
		fin_context()
	end
end

-- Fix the punch logic to properly unlink nodes from their parent nodeset before destruction
local punch = function(self, puncher, time_from_last_punch, tool_capabilities, dir, damage)
	local node = self:get_node()
	local def = node and core.registered_nodes[node.name]
	if not def then return end
	
	init_context(self)
	local relpos = construct_relpos(self)
	
	if def.on_punch then
		def.on_punch(relpos, node, puncher, {
			type = "node",
			under = convert_pos(relpos),
			above = nil
		}, self)
	end
	
	local can_dig = true
	if def.can_dig then
		can_dig = def.can_dig(relpos, puncher, self)
	end
	if can_dig then
		if core.node_dig then
			core.node_dig(relpos, node, puncher, self)
		else
			-- Fallback cleanup when the engine node_dig path is unavailable
			local parent_obj, _, _ = self.object:get_attach()
			if parent_obj and parent_obj:is_valid() then
				local parent_ent = parent_obj:get_luaentity()
				if parent_ent and parent_ent._attachments then
					for key, eID in pairs(parent_ent._attachments) do
						if eID == self._eID then
							parent_ent._attachments[key] = nil
							break
						end
					end
				end
			end

			if self._invname then
				core.remove_detached_inventory(self._invname)
			end
			nodeentities[self._eID] = nil
			usednames:set_string(self._eID, "")
			self.object:remove()
		end
	else
		fin_context()
		return true
	end
	fin_context()
end

local generate_eID = function()
	local eID
	repeat
		eID = ("%x%x"):format(math.random(16777216),math.random(16777216))
	until not (nodeentities[eID] or usednames:contains(eID))
	return eID
end

local eval_number = function(str, default)
	if str == "" then return default end
	return tonumber(str, 16)
end

local eval_string = function(str, default)
	if str == "" then return default end
	return str
end

local activate = function(self, staticdata, dtime_s)
	self._timer = create_detached_nodetimer()
	local data = {"", "", "", "", ""}
	if staticdata and (staticdata ~= "") then
		data = staticdata:split("|", true, 4)
	end
	local nodename = data[4]
	if nodename == "ignore" or nodename == "air" or nodename == "" then
		self._NOELIM = true
		return self.object:remove()
	end
	local eID = data[1]
	local init
	if eID == "" then
		eID = generate_eID()
		init = true
	end
	if nodeentities[eID] and nodeentities[eID].object:is_valid() then
		self._NOELIM = true
		return self.object:remove()
	end
	nodeentities[eID] = self
	usednames:set_string(eID, "1")
	self._eID = eID
	local invname = "steamified"..eID
	self._invname = invname
	local metaref = create_detached_nodemeta(invname, invcallbacks(self))
	self._metadata = metaref
	self._timer:set(tonumber(data[2]), tonumber(data[3]))
	
	staticdata = data[5]
	metaref:from_table(core.deserialize(staticdata:sub(5)) or {})
	local def = core.registered_nodes[nodename] or {}
	self:set_node({
		param1 = eval_number(staticdata:sub(1,2), 240) or 240,
		param2 = eval_number(staticdata:sub(3,4), def.place_param2 or 0) or 0,
		name   = nodename
	})

	local relpos = construct_relpos(self)

	if def.on_construct then
		init_context(self)
		def.on_construct(relpos, self)
		fin_context()
	end

	self._showfs = newshowformspec(self)
	local node = self:get_node()
	for _, lbm in ipairs(core.registered_lbms) do
		if lbm.run_at_every_load then 
			-- FIX: Prevent entities from triggering fire generation/spread LBMs
			local lbm_name = lbm.name or ""
			if not (lbm_name:find("fire") or lbm_name:find("ignite")) then
				for _, name in ipairs(lbm.nodenames) do
					if (node.name == name) or ((name:sub(1,6) == "group:") and (core.get_item_group(node.name, name:sub(7)) ~= 0)) then
						lbm.action(relpos, node, dtime_s, self)
						break
					end
				end
			end
		end
	end
end

local step = function(self, dtime, moveresult)
	local node = self:get_node()
	if not node or not node.name then
		return
	end
	local def = core.registered_nodes[node.name]
	if not def then
		return
	end
	local pos = construct_relpos(self)
	local timer = self._timer
	if timer:tick(dtime) then
		if def.on_timer(pos, timer.prevtimeout, self) then
			timer:start(timer.prevtimeout)
		end
	end
	-- Encode the actual node name here too
	local fname = "steamified:" .. node.name:gsub(":", "__") .. ";" .. self._eID
	local fs = self._metadata:get_string("formspec")
	local parsedfs = parseformspec(fs, self)
	if self._prevfs and (parsedfs ~= self._prevfs) then
		for pname, fsc in pairs(fs_context[fname] or {}) do
			self._showfs(pname, fname, fs)
		end
	end
	local newtimerabm = timer.abm + dtime
	self.object:set_properties({infotext = self._metadata:get_string("infotext")})
	local node = self:get_node()
	-- Run custom registered node ticks
	local custom_tick = registered_ticks[node.name]
	if custom_tick then
		custom_tick(self, dtime, pos)
	end
	for _, abm in ipairs(core.registered_abms) do
		if ((timer.abm % abm.interval) > (newtimerabm % abm.interval)) and (math.random(abm.chance) == 1) then
			for _, name in ipairs(abm.nodenames) do
				if (node.name == name) or ((name:sub(1,6) == "group:") and (core.get_item_group(node.name, name:sub(7)) ~= 0)) then
					if check_neighbors(pos, abm.neighbors, abm.without_neighbors) then
						abm.action(pos, node, 0, 0, self, dtime, moveresult) -- missing object counts
					end
					break
				end
			end
		end
	end
	timer.abm = newtimerabm
	if def._steamified_step then
		def._steamified_step(self, dtime, moveresult)
	end
end

core.register_entity(entityname, {
	initial_properties = {

		visual = "node",
		-- Node to show when using the "node" visual

		makes_footstep_sound = true,
		-- If true, object is able to make footstep sounds of nodes
		-- (see node sound definition for details).

		damage_texture_modifier = "^[brighten",
		-- Texture modifier to be applied for a short duration when object is hit
	},

	on_activate = activate,
	on_deactivate = deactivate,
	on_step = step,
	on_punch = punch,
	on_death = death,
	on_rightclick = rclick,
	--[[
	on_attach_child = function(self, child) end,
	on_detach_child = function(self, child) end,
	on_detach = function(self, parent) end,
	]]
	get_node = function(self)
		-- Retrieve from Lua memory instead of unsafe C++ property retrieval
		return self._node or {name = "air", param1 = 0, param2 = 0}
	end,
	
	set_node = function(self, node)
		local def = core.registered_nodes[node.name] or {}

		-- 1. Safely resolve the selection box into a strict 6-number array
		local selbox = { -0.5, -0.5, -0.5, 0.5, 0.5, 0.5 }
		if def.selection_box then
			if def.selection_box.type == "fixed" or def.selection_box.type == "regular" then
				local fixed = def.selection_box.fixed
				if type(fixed) == "table" then
					selbox = type(fixed[1]) == "table" and fixed[1] or fixed
				end
			end
		elseif def.drawtype == "nodebox" and def.node_box then
			local fixed = def.node_box.fixed
			if type(fixed) == "table" then
				selbox = type(fixed[1]) == "table" and fixed[1] or fixed
			end
		end
		
		-- Fallback if the table is malformed
		if type(selbox) ~= "table" or #selbox < 6 then
			selbox = { -0.5, -0.5, -0.5, 0.5, 0.5, 0.5 }
		end
		
		local final_selbox = table.copy(selbox)
		final_selbox.rotate = true

		-- 2. Safely resolve the collision box into a strict 6-number array
		local collbox = { -0.5, -0.5, -0.5, 0.5, 0.5, 0.5 }
		if def.collision_box then
			if def.collision_box.type == "fixed" or def.collision_box.type == "regular" then
				local fixed = def.collision_box.fixed
				if type(fixed) == "table" then
					collbox = type(fixed[1]) == "table" and fixed[1] or fixed
				end
			end
		elseif def.drawtype == "nodebox" and def.node_box then
			local fixed = def.node_box.fixed
			if type(fixed) == "table" then
				collbox = type(fixed[1]) == "table" and fixed[1] or fixed
			end
		end

		if type(collbox) ~= "table" or #collbox < 6 then
			collbox = { -0.5, -0.5, -0.5, 0.5, 0.5, 0.5 }
		end

		-- 3. Save the node data safely in Lua, NOT in C++ properties
		self._node = node

		-- 4. Apply standard engine-safe properties (Immunity to sun/burn hooks)
		self.object:set_properties({
			visual = "wielditem",
			wield_item = node.name,
			visual_size = {x = 0.667, y = 0.667},
			selectionbox = final_selbox,
			glow = def.light_source or 0,
			physical = true, -- Handled dynamically via rigidbody wrapper system
			pointable = def.pointable or (def.pointable == nil),
			collide_with_objects = true,
			collisionbox = collbox,
		})
		self.object:set_armor_groups({immortal = 1, fleshy = 0})
	end,
	get_staticdata = function(self)
		local node = self:get_node()
		local timer = self._timer
		if not node or not node.name then
			return string.format("%s|%f|%f|ignore|0000%s", self._eID, timer.timeout, timer.elapsed, (self._metadata and core.serialize(self._metadata:to_table())) or "")
		end
		return string.format("%s|%f|%f|%s|%02x%02x%s", self._eID, timer.timeout, timer.elapsed, node.name, node.param1 or 0, node.param2 or 0, (self._metadata and core.serialize(self._metadata:to_table())) or "")
	end,
})

local nodesetname = "steamified:nodeset"

core.register_entity(nodesetname, {
	
	initial_properties = {

		visual =  "upright_sprite",
		textures = {"blank.png", "blank.png"},

		shaded = false,

		static_save = true,
		-- If false, never save this object statically. It will simply be
		-- deleted when the block gets unloaded.
		-- The get_staticdata() callback is never called then.
		-- Defaults to 'true'.
	},
	-- A table of object properties, see the `Object properties` section.
	-- The properties in this table are applied to the object
	-- once when it is spawned.

	-- Refer to the "Registered entities" section for explanations
	on_activate = function(self, staticdata, dtime_s)
		if staticdata and staticdata ~= "" then
			self._attachments = core.deserialize(staticdata)
		else
			self._attachments = {}
		end
		if not self._eID then
			self._eID = string.format("%x%x", math.random(16777216), math.random(16777216))
		end
		steamified.nodeentities[self._eID] = self
	end,
	on_step = function(self, dtime, moveresult)
		if not self._attachments then return end
		for pos, eID in pairs(self._attachments) do
			local child = nodeentities[eID]
			if child and child.object:is_valid() then
				local listpos = pos:split("|")
				child.object:set_attach(self.object, "", 10 * vector.new(tonumber(listpos[1], 16) - 32768, tonumber(listpos[2], 16) - 32768, tonumber(listpos[3], 16) - 32768))
			end
		end
	end,
	on_attach_child = function(self, child)
		if not child or not child:is_valid() then return end
		local entity = child:get_luaentity()
		if not entity or entity.name ~= "steamified:node" then return end

		local _, _, attachpos = child:get_attach()
		if not attachpos then return end
		self._attachments[("%04x|%04x|%04x"):format(attachpos.x * 0.1 + 32768, attachpos.y * 0.1 + 32768, attachpos.z * 0.1 + 32768)] = entity._eID
	end,
	on_detach_child = function(self, child)
		if not child or not child:is_valid() then return end
		local entity = child:get_luaentity()
		if not entity or entity.name ~= "steamified:node" then return end
		if entity._NOREMOVE then return end

		local _, _, attachpos = child:get_attach()
		if not attachpos then return end
		self._attachments[("%04x|%04x|%04x"):format(attachpos.x * 0.1 + 32768, attachpos.y * 0.1 + 32768, attachpos.z * 0.1 + 32768)] = nil
	end,
	get_staticdata = function(self)
		return core.serialize(self._attachments)
	end,
})

local function add_steamified(pos, node)
	if node.name == "ignore" or node.name == "air" then return end
	-- Explicitly format and append param1 and param2 into the staticdata string
	return core.add_entity(pos, entityname, string.format("|0|0|%s|%02x%02x", node.name, node.param1 or 0, node.param2 or 0))
end

steamified.add = add_steamified

-- Add this to the very bottom of nodeentity.lua
function steamified.get_nodeset_under_pos(pos)
    for id, ent in pairs(steamified.nodeentities) do
        if ent and ent.object and ent.object:is_valid() and ent._nodes then
            local parent_pos = ent.object:get_pos()
            local parent_rot = ent.object:get_rotation()
            
            -- Translate world player position into the nodeset's local space coordinates
            local local_pos = vector.subtract(pos, parent_pos)
            if parent_rot.y ~= 0 then
                local_pos = vector.rotate_around_axis(local_pos, {x = 0, y = 1, z = 0}, -parent_rot.y)
            end
            
            -- Round to find the exact local grid integer position
            local check_node = {
                x = math.floor(local_pos.x + 0.5),
                y = math.floor(local_pos.y + 0.5),
                z = math.floor(local_pos.z + 0.5)
            }
            
            -- Look up if a real solid block exists at this relative coordinate string
            local key = check_node.x .. "," .. check_node.y .. "," .. check_node.z
            if ent._nodes[key] then
                return ent.object -- Found it! Return the valid master object reference
            end
        end
    end
    return nil
end

core.register_on_mods_loaded(function()
	core.register_on_player_receive_fields(function(player, formname, fields)
		if formname:sub(0, 11) == "steamified:" then
			local data = formname:split(";", true, 1)
			local nodename = (data[1]):gsub("steamified:",""):gsub("__",":")
			local def = core.registered_nodes[nodename]
			local entity = nodeentities[data[2]]
			-- Check if both the node definition and its receive fields callback exist
			if def and def.on_receive_fields then
				init_context(entity)
				def.on_receive_fields(construct_relpos(entity), formname, fields, player, entity)
				fin_context()
			end
		end
	end)

	local oldisprotected = core.is_protected
	core.is_protected = function(pos, player)
		if pos.relative then
			local entity = nodeentities[pos.relative]
			if not entity then return end
			if entity.object:is_valid() then
				return oldisprotected(entity.object:get_pos():offset(pos.x, pos.y, pos.z), player)
			end
		else
			return oldisprotected(pos, player)
		end
	end

	core.after(0, function()

	local vmanipmeta = getmetatable(VoxelManip())

	local oldvmget = vmanipmeta.get_node_at
	vmanipmeta.get_node_at = function(self, pos)
		local steamifiedpos = find_steamified(pos)
		if steamifiedpos then
			if steamifiedpos.object then
				uncommited[self] = uncommited[self] or {}
				uncommited[self][core.hash_node_position(pos)] = function()
					steamifiedpos:set_node(node) -- Changed from steamifiedpos.object:set_properties
				end
				return steamifiedpos:get_node() -- Changed from steamifiedpos.object:get_properties().node
			end
			return oldvmget(self, steamifiedpos)
		end
		return {name = "ignore", param1 = 0, param2 = 0}
	end

	local oldvmset = vmanipmeta.set_node_at
	vmanipmeta.set_node_at = function(self, pos, node)
		local steamifiedpos, attachment = find_steamified(pos)
		if steamifiedpos then
			if steamifiedpos.object then
				uncommited[self] = uncommited[self] or {}
				uncommited[self][core.hash_node_position(pos)] = function()
					steamifiedpos.object:set_properties({node = node})
				end
			elseif attachment then
				uncommited[self] = uncommited[self] or {}
				uncommited[self][core.hash_node_position(pos)] = function()
					local newnode = steamified.add(attachment.parent:get_pos():offset(pos.x, pos.y, pos.z), node, true)
					newnode:set_attach(attachment.parent, "", vector.multiply(pos, 10))
				end
			else
				oldvmset(self, steamifiedpos, node)
			end
		end
	end

	local oldvmwrite = vmanipmeta.write_to_map
	vmanipmeta.write_to_map = function(self, light)
		oldvmwrite(self, light)
		if not uncommited[self] then return end
		for k, v in pairs(uncommited[self]) do v() end
	end

	local dummy = core.add_entity(veczero, nodesetname)
	local objmeta = getmetatable(dummy)
	dummy:remove()

	convert_method(objmeta, "set_pos")
	convert_method(objmeta, "move_to")

	end)
end)

function steamified.read_world(pos, anchor, minp, maxp)
	local minp, maxp = vector.sort(convert_pos(minp), convert_pos(maxp))
	local pos = convert_pos(pos)
	local anchor = convert_pos(anchor)
	assert(pos, "can't read from the void")
	assert(anchor, "can't place in the void")
	local vm = VoxelManip(minp, maxp)
	local nodeset = core.add_entity(pos, nodesetname)
	if not nodeset or not nodeset:get_luaentity() then
		return
	end
	local nodepos = vector.zero()
	for x = minp.x, maxp.x do
	for y = minp.y, maxp.y do
	for z = minp.z, maxp.z do
		nodepos.x, nodepos.y, nodepos.z = x, y, z
		local node = vm:get_node_at(nodepos)
		if node and node.name and (node.name ~= "air") and (node.name ~= "ignore") then
			local newobject = add_steamified(nodepos, node)
			if newobject then
				local newentity = newobject:get_luaentity()
				if newentity and newentity._metadata then
					-- FIX: Changed from 'oldgetmeta' to the valid 'real_get_meta' reference
					local nodemeta = real_get_meta(nodepos)
					if nodemeta then
						newentity._metadata:from_table(nodemeta:to_table())
					end
					newobject:set_attach(nodeset, "", (nodepos - anchor) * 10)
				else
					newobject:remove()
				end
			end
		end
	end end end
	return nodeset
end

local active_seats = {
    -- [player_name] = true
}

-- Safe dismount cleanup function
local function player_dismount_seat(player)
    local pname = player:get_player_name()
    if not active_seats[pname] then return end

    player:set_detach()
    player:set_eye_offset({x = 0, y = 0, z = 0}, {x = 0, y = 0, z = 0})
    
    if default and default.player_set_animation then
        default.player_set_animation(player, "stand", 30)
    end

    active_seats[pname] = nil
end

minetest.register_node("steamified:seat", {
    description = "Copper Engineers Seat",
    drawtype = "nodebox",
    paramtype = "light",
    paramtype2 = "facedir",
    tiles = {
        "default_copper_block.png", "default_copper_block.png",
        "default_copper_block.png", "default_copper_block.png",
        "default_copper_block.png", "default_copper_block.png"
    },
    groups = {cracky = 2, oddly_breakable_by_hand = 1},
    node_box = {
        type = "fixed",
        fixed = {
            { -0.5, -0.5, -0.5,  0.5,  0.0,  0.5 }, -- Cushion
            { -0.5,  0.0,  0.2,  0.5,  0.5,  0.5 }, -- Backrest
        },
    },

    on_rightclick = function(pos, node, clicker, itemstack, pointed_thing)
        if not clicker or not clicker:is_player() then return end
        local pname = clicker:get_player_name()

        -- If already sitting, stand up
        if active_seats[pname] then
            player_dismount_seat(clicker)
            return
        end

        -- Find the specific seat child entity belonging to a nodeset assembly
        local seat_entity_object = nil

        -- Scan nearby objects to locate the child node entity at this position
        local objects = minetest.get_objects_inside_radius(pos, 0.5)
        for _, obj in ipairs(objects) do
            local ent = obj:get_luaentity()
            -- Check if it's a node entity block and if its internal node definition matches our seat
            if ent and ent.name == "steamified:node" and ent.get_node then
                if ent:get_node().name == "steamified:seat" then
                    seat_entity_object = obj
                    break
                end
            end
        end

        if seat_entity_object then
            -- Native engine attachment: attaches player to the seat entity block directly
            -- Offset y = 2 to position the player model onto the cushion top
            clicker:set_attach(seat_entity_object, "", {x = 0, y = 2, z = 0}, {x = 0, y = 0, z = 0})
            
            clicker:set_eye_offset({x = 0, y = -2, z = 0}, {x = 0, y = -2, z = 0})
            if default and default.player_set_animation then
                default.player_set_animation(clicker, "sit", 30)
            end
            active_seats[pname] = true
        else
            -- Fallback: If placed normally on the ground (static block, not an entity assembly)
            clicker:set_pos({x = pos.x, y = pos.y + 0.05, z = pos.z})
            clicker:set_eye_offset({x = 0, y = -3.5, z = 0}, {x = 0, y = -3.5, z = 0})
            if default and default.player_set_animation then
                default.player_set_animation(clicker, "sit", 30)
            end
            active_seats[pname] = true
        end
    end,

    on_dig = function(pos, node, digger)
        if digger and digger:is_player() then
            player_dismount_seat(digger)
        end
        return minetest.node_dig(pos, node, digger)
    end
})

-- Handle jump dismount input tracking cleanly
minetest.register_globalstep(function(dtime)
    for pname, _ in pairs(active_seats) do
        local player = minetest.get_player_by_name(pname)
        if not player or not player:is_valid() then
            active_seats[pname] = nil
            goto next_seat
        end

        -- Let the player press Jump to break out of the seat
        local ctrl = player:get_player_control()
        if ctrl.jump then
            player_dismount_seat(player)
            -- Give a small upward physical boost when hopping off
            player:add_velocity({x = 0, y = 2, z = 0})
        end

        ::next_seat::
    end
end)

minetest.register_on_leaveplayer(function(player)
    active_seats[player:get_player_name()] = nil
end)